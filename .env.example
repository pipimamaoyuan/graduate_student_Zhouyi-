# Multiple providers are tried from small index to large index.
# Provider 1 is tried first; if it fails, provider 2 is tried, then provider 3...

OPENAI_API_KEY_1=your_first_api_key_here
OPENAI_BASE_URL_1=https://api.openai.com/v1
OPENAI_MODEL_1=gpt-4.1-mini

OPENAI_API_KEY_2=your_second_api_key_here
OPENAI_BASE_URL_2=https://api.chatanywhere.tech/v1
OPENAI_MODEL_2=gpt-4.1-mini

# Optional: add more providers up to _20
# OPENAI_API_KEY_3=your_third_api_key_here
# OPENAI_BASE_URL_3=https://example.com/v1
# OPENAI_MODEL_3=model-name

# Optional: show model info below AI answer. 0 = hide, 1 = show.
SHOW_AI_MODEL=0

# Optional safety limits for public access.
# AI_TIMEOUT_MS: abort one model request after this many milliseconds.
# MAX_REQUEST_BYTES: reject oversized /api/interpret JSON bodies.
# MAX_QUESTION_CHARS: limit the user's question text length.
# RATE_LIMIT_WINDOW_MS and RATE_LIMIT_MAX: per-IP request limit for /api/interpret.
AI_TIMEOUT_MS=30000
MAX_REQUEST_BYTES=32768
MAX_QUESTION_CHARS=300
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=6

# Optional: local port. Changing PORT still requires restarting server.js.
PORT=3000


# 阿里通义千问（DashScope/百炼）语音 API：实时语音识别(ASR) + 语音合成(TTS)
# 用于「倾听树洞」子功能的实时语音对话
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 通义千问语音：域名与模型（业务空间用户填自己的专属域名）
DASHSCOPE_BASE_HTTP_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_BASE_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
DASHSCOPE_ASR_MODEL=qwen-audio-3.0-asr-flash-streaming
DASHSCOPE_TTS_MODEL=qwen-audio-3.0-tts-flash
DASHSCOPE_TTS_VOICE=longanhuan_v3.6
